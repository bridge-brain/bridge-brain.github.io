---
interface Props {
  lang?: "de" | "en";
}

const { lang = "de" } = Astro.props;

const content = {
  de: {
    sectionTag: "Kontakt",
    headline: "Lassen Sie uns sprechen",
    subheadline:
      "Haben Sie Fragen oder möchten Sie mehr erfahren? Wir freuen uns auf Ihre Nachricht.",
    address: "Adresse",
    email: "E-Mail",
    generalEmail: "info",
  },
  en: {
    sectionTag: "Contact",
    headline: "Let's talk",
    subheadline:
      "Have questions or want to learn more? We look forward to hearing from you.",
    address: "Address",
    email: "Email",
    generalEmail: "info",
  },
};

const t = content[lang];

const companyInfo = {
  name: "Bridgebrain.AI GmbH",
  street: "Ölmühlweg 33",
  city: "61462 Königstein im Taunus",
  country: lang === "de" ? "Deutschland" : "Germany",
};
---

<section id="kontakt" class="py-24 lg:py-32">
  <div class="container-narrow">
    <!-- Section Header -->
    <div class="text-center mb-16">
      <span
        class="inline-block px-4 py-2 bg-brand-blue/10 text-brand-blue-dark text-sm font-medium rounded-full mb-6 animate-on-scroll"
      >
        {t.sectionTag}
      </span>
      <h2
        class="text-3xl sm:text-4xl lg:text-5xl font-bold mb-6 animate-on-scroll"
      >
        {t.headline}
      </h2>
      <p class="text-lg text-slate-600 max-w-2xl mx-auto animate-on-scroll">
        {t.subheadline}
      </p>
    </div>

    <!-- Contact Cards -->
    <div class="grid md:grid-cols-2 gap-8 max-w-3xl mx-auto">
      <!-- Address Card -->
      <div class="card animate-on-scroll">
        <div class="flex items-start gap-4">
          <div
            class="w-12 h-12 bg-brand-navy/5 rounded-xl flex items-center justify-center flex-shrink-0"
          >
            <svg
              class="w-6 h-6 text-brand-navy"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="1.5"
                d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
              ></path>
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="1.5"
                d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
            </svg>
          </div>
          <div>
            <h3 class="font-semibold text-lg mb-2">{t.address}</h3>
            <a
              href="https://www.google.com/maps/place/BridgeBrain+%7C+Organisationsentwicklung+%7C+Teamentwicklung+%7C+Business+Coaching+%7C+Frankfurt/@50.1867743,8.4521484,17z/data=!3m1!4b1!4m6!3m5!1s0x47bd09e86877ebfd:0x7077ad2a1539b965!8m2!3d50.1867743!4d8.4547287!16s%2Fg%2F11gp68td05?entry=ttu&g_ep=EgoyMDI2MDEwNy4wIKXMDSoKLDEwMDc5MjA3MUgBUAM%3D"
              hover:text-brand-blue
              transition-colors
            >
              <address class="text-slate-600 not-italic leading-relaxed">
                {companyInfo.name}<br />
                {companyInfo.street}<br />
                {companyInfo.city}<br />
                {companyInfo.country}
              </address>
            </a>
          </div>
        </div>
      </div>

      <!-- Email Card -->
      <div class="card animate-on-scroll" style="animation-delay: 100ms">
        <div class="flex items-start gap-4">
          <div
            class="w-12 h-12 bg-brand-blue/10 rounded-xl flex items-center justify-center flex-shrink-0"
          >
            <svg
              class="w-6 h-6 text-brand-blue"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="1.5"
                d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
              ></path>
            </svg>
          </div>
          <div>
            <h3 class="font-semibold text-lg mb-2">{t.email}</h3>
            <a
              href="mailto:info@bridge-brain.ai"
              class="text-slate-600 hover:text-brand-blue transition-colors inline-flex items-center gap-2 group"
            >
              <span
                class="contact-email"
                data-user="info"
                data-domain="bridge-brain.ai"
              >
                info[at]bridge-brain[dot]ai
              </span>
              <svg
                class="w-4 h-4 opacity-0 -translate-x-2 group-hover:opacity-100 group-hover:translate-x-0 transition-all duration-300"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
              </svg>
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  // Simple email de-obfuscation on hover/focus
  document.querySelectorAll(".contact-email").forEach((el) => {
    const user = el.getAttribute("data-user");
    const domain = el.getAttribute("data-domain");

    const reveal = () => {
      if (user && domain) {
        el.textContent = `${user}@${domain}`;
      }
    };

    el.closest("a")?.addEventListener("mouseenter", reveal);
    el.closest("a")?.addEventListener("focus", reveal);
  });
</script>
