---
interface Props {
  lang?: 'de' | 'en';
}

const { lang = 'de' } = Astro.props;

const content = {
  de: {
    sectionTag: 'Unsere Produktentwicklung',
    headline: 'KI-Anwendungen für strategische Arbeit',
    intro1: 'bridgebrAIn entwickelt spezialisierte KI-Anwendungen für strategische Arbeit im Mittelstand. Ziel ist es, typische Managementaufgaben – etwa strategische Analyse, Entscheidungsstrukturierung oder Transformationssteuerung – durch KI sinnvoll zu unterstützen.',
    intro2: 'Die Anwendungen kombinieren moderne KI-Technologie mit erprobten Managementmethoden und sind gezielt auf die Anforderungen mittelständischer Unternehmen ausgerichtet.',
    focusLabel: 'Schwerpunktthemen',
    topics: [
      { title: 'Strategieentwicklung', icon: 'chart' },
      { title: 'Finanzen & Controlling', icon: 'finance' },
      { title: 'Prozessoptimierung', icon: 'process' },
      { title: 'Strukturierung von Management- und Transformationsprozessen', icon: 'transform' },
    ],
  },
  en: {
    sectionTag: 'Our Product Development',
    headline: 'AI Applications for Strategic Work',
    intro1: 'bridgebrAIn develops specialized AI applications for strategic work in SMEs. The goal is to meaningfully support typical management tasks – such as strategic analysis, decision structuring, or transformation management – through AI.',
    intro2: 'The applications combine modern AI technology with proven management methods and are specifically tailored to the needs of small and medium-sized enterprises.',
    focusLabel: 'Focus Areas',
    topics: [
      { title: 'Strategy Development', icon: 'chart' },
      { title: 'Finance & Controlling', icon: 'finance' },
      { title: 'Process Optimization', icon: 'process' },
      { title: 'Structuring Management and Transformation Processes', icon: 'transform' },
    ],
  },
};

const t = content[lang];
---

<section id="produkte" class="py-24 lg:py-32">
  <div class="container-wide">
    <div class="grid lg:grid-cols-2 gap-16 items-center">
      <!-- Left: Text -->
      <div>
        <span class="inline-block px-4 py-2 bg-brand-navy/5 text-brand-navy text-sm font-medium rounded-full mb-6 animate-on-scroll">
          {t.sectionTag}
        </span>
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold mb-6 animate-on-scroll">
          {t.headline}
        </h2>
        <p class="text-slate-600 leading-relaxed mb-4 animate-on-scroll">
          {t.intro1}
        </p>
        <p class="text-slate-600 leading-relaxed animate-on-scroll">
          {t.intro2}
        </p>
      </div>

      <!-- Right: Topics -->
      <div class="animate-on-scroll">
        <p class="text-sm font-semibold text-brand-navy uppercase tracking-wider mb-6">{t.focusLabel}</p>
        <div class="space-y-4">
          {t.topics.map((topic, index) => (
            <div
              class="flex items-center gap-4 p-4 bg-slate-50 rounded-2xl hover:bg-brand-blue/5 transition-colors duration-200"
              style={`animation-delay: ${(index + 1) * 100}ms`}
            >
              <div class="w-10 h-10 bg-brand-navy rounded-xl flex items-center justify-center flex-shrink-0">
                {topic.icon === 'chart' && (
                  <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
                  </svg>
                )}
                {topic.icon === 'finance' && (
                  <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                  </svg>
                )}
                {topic.icon === 'process' && (
                  <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
                  </svg>
                )}
                {topic.icon === 'transform' && (
                  <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
                  </svg>
                )}
              </div>
              <span class="font-medium text-brand-navy">{topic.title}</span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
