---
interface Props {
  lang?: 'de' | 'en';
}

const { lang = 'de' } = Astro.props;

const content = {
  de: {
    sectionTag: 'Das Team',
    headline: 'Menschen hinter der Technologie',
    subheadline: 'Wir verbinden Technologie-Expertise mit Strategieerfahrung.',
  },
  en: {
    sectionTag: 'The Team',
    headline: 'People behind the technology',
    subheadline: 'We combine technology expertise with strategic experience.',
  }
};

const team = [
  {
    name: 'Thorsten Voigt',
    role: {
      de: 'Geschäftsführer',
      en: 'Managing Director',
    },
    email: 'thorsten.voigt',
    linkedin: 'https://www.linkedin.com/in/drtv/',
    image: '/team/thorsten.jpg',
  },
  {
    name: 'Matthias von Tettau',
    role: {
      de: 'Geschäftsführer',
      en: 'Managing Director',
    },
    email: 'matthias.vontettau',
    linkedin: 'https://www.linkedin.com/in/matthias-freiherr-von-tettau-8861174/',
    image: '/team/matthias.jpg',
  },
  {
    name: 'Michael Oesterle',
    role: {
      de: 'Chief AI Officer',
      en: 'Chief AI Officer',
    },
    email: 'michael.oesterle',
    linkedin: 'https://www.linkedin.com/in/michoest/',
    image: '/team/michael.jpg',
  },
];

const t = content[lang];

// Function to obfuscate email
const obfuscateEmail = (name: string) => {
  const domain = 'bridge-brain.ai';
  return `${name}[at]${domain.replace('.', '[dot]')}`;
};
---

<section id="team" class="py-24 lg:py-32 bg-slate-50/50">
  <div class="container-wide">
    <!-- Section Header -->
    <div class="text-center mb-16 lg:mb-20">
      <span class="inline-block px-4 py-2 bg-brand-navy/5 text-brand-navy text-sm font-medium rounded-full mb-6 animate-on-scroll">
        {t.sectionTag}
      </span>
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold mb-6 animate-on-scroll">
        {t.headline}
      </h2>
      <p class="text-lg text-slate-600 max-w-2xl mx-auto animate-on-scroll">
        {t.subheadline}
      </p>
    </div>

    <!-- Team Grid -->
    <div class="grid md:grid-cols-3 gap-8 lg:gap-12">
      {team.map((member, index) => (
        <div class="card text-center group animate-on-scroll" style={`animation-delay: ${(index + 1) * 100}ms`}>
          <!-- Photo -->
          <div class="relative w-32 h-32 mx-auto mb-6">
            {member.image ? (
              <img 
                src={member.image} 
                alt={member.name}
                class="w-full h-full object-cover rounded-full ring-4 ring-white shadow-lg"
              />
            ) : (
              <div class="w-full h-full bg-gradient-to-br from-brand-navy to-brand-blue rounded-full flex items-center justify-center ring-4 ring-white shadow-lg">
                <span class="text-3xl font-bold text-white">
                  {member.name.split(' ').map(n => n[0]).join('')}
                </span>
              </div>
            )}
            
            <!-- Decorative ring on hover -->
            <div class="absolute inset-0 rounded-full ring-2 ring-brand-blue/0 group-hover:ring-brand-blue/50 transition-all duration-300 scale-110"></div>
          </div>

          <!-- Info -->
          <h3 class="text-xl font-semibold mb-1">{member.name}</h3>
          <p class="text-brand-blue font-medium mb-4">{member.role[lang]}</p>
          
          <!-- Contact -->
          <div class="flex items-center justify-center gap-4">
            <a 
              href={`mailto:${member.email}@bridge-brain.ai`}
              class="text-sm text-slate-500 hover:text-brand-navy transition-colors"
              data-email={obfuscateEmail(member.email)}
              aria-label={`E-Mail an ${member.name}`}
            >
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
            </a>
            {member.linkedin && member.linkedin !== '#' && (
              <a 
                href={member.linkedin}
                target="_blank"
                rel="noopener noreferrer"
                class="text-sm text-slate-500 hover:text-brand-navy transition-colors"
                aria-label={`LinkedIn-Profil von ${member.name}`}
              >
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
                </svg>
              </a>
            )}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  // Email obfuscation - replace displayed emails on load
  document.querySelectorAll('[data-email]').forEach(el => {
    const obfuscated = el.getAttribute('data-email');
    if (obfuscated) {
      el.setAttribute('title', obfuscated);
    }
  });
</script>
