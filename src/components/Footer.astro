---
interface Props {
  lang?: 'de' | 'en';
}

const { lang = 'de' } = Astro.props;

const footer = {
  de: {
    legal: 'Rechtliches',
    imprint: 'Impressum',
    privacy: 'Datenschutz',
    rights: 'Alle Rechte vorbehalten.',
  },
  en: {
    legal: 'Legal',
    imprint: 'Imprint',
    privacy: 'Privacy Policy',
    rights: 'All rights reserved.',
  }
};

const t = footer[lang];
const currentYear = new Date().getFullYear();
---

<footer class="mt-auto border-t border-slate-100 bg-slate-50/50">
  <div class="container-wide py-12">
    <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-8">
      <!-- Logo & Copyright -->
      <div class="flex flex-col gap-4">
        <a href={lang === 'de' ? '/' : '/en'}>
          <img 
            src="/logo.png" 
            alt="bridgebrAIn" 
            class="h-8 w-auto opacity-80 hover:opacity-100 transition-opacity"
          />
        </a>
        <p class="text-sm text-slate-500">
          © {currentYear} Bridgebrain.AI GmbH. {t.rights}
        </p>
      </div>

      <!-- Legal Links -->
      <div class="flex flex-col sm:flex-row gap-6 sm:gap-8">
        <div class="flex flex-col gap-2">
          <span class="text-xs font-semibold text-slate-400 uppercase tracking-wider">{t.legal}</span>
          <div class="flex gap-6">
            <a 
              href={lang === 'de' ? '/impressum' : '/en/imprint'} 
              class="text-sm text-slate-600 hover:text-brand-navy transition-colors"
            >
              {t.imprint}
            </a>
            <a 
              href={lang === 'de' ? '/datenschutz' : '/en/privacy'} 
              class="text-sm text-slate-600 hover:text-brand-navy transition-colors"
            >
              {t.privacy}
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</footer>
