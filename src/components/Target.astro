---
interface Props {
  lang?: 'de' | 'en';
}

const { lang = 'de' } = Astro.props;

const content = {
  de: {
    sectionTag: 'Unsere Kunden',
    headline: 'Gemacht für den Mittelstand',
    description: 'bridgebrAIn richtet sich an mittelständische Unternehmen, die KI gezielt für Management- und Strategieprozesse einsetzen möchten, konkrete Use Cases identifizieren wollen und ihre Entscheidungsprozesse stärker strukturieren und datenbasiert gestalten möchten.',
    criteria: [
      'KI gezielt für Management- und Strategieprozesse einsetzen',
      'Konkrete Use Cases in der eigenen Organisation identifizieren',
      'Entscheidungsprozesse stärker strukturieren und datenbasiert gestalten',
    ],
  },
  en: {
    sectionTag: 'Our clients',
    headline: 'Built for the Mittelstand',
    description: 'bridgebrAIn is designed for SMEs that want to deploy AI specifically for management and strategy processes, identify concrete use cases within their organization, and make their decision-making more structured and data-driven.',
    criteria: [
      'Deploy AI specifically for management and strategy processes',
      'Identify concrete use cases within their own organization',
      'Make decision-making more structured and data-driven',
    ],
  },
};

const t = content[lang];
---

<section id="zielgruppe" class="py-24 lg:py-32 bg-slate-50/50">
  <div class="container-narrow">
    <div class="text-center mb-12">
      <span class="inline-block px-4 py-2 bg-brand-blue/10 text-brand-blue-dark text-sm font-medium rounded-full mb-6 animate-on-scroll">
        {t.sectionTag}
      </span>
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold mb-6 animate-on-scroll">
        {t.headline}
      </h2>
      <p class="text-lg text-slate-600 leading-relaxed max-w-2xl mx-auto animate-on-scroll">
        {t.description}
      </p>
    </div>

    <div class="grid sm:grid-cols-3 gap-6 animate-on-scroll">
      {t.criteria.map((item, index) => (
        <div
          class="card text-center"
          style={`animation-delay: ${(index + 1) * 100}ms`}
        >
          <div class="w-12 h-12 bg-brand-blue/10 rounded-xl flex items-center justify-center mx-auto mb-4">
            <svg class="w-6 h-6 text-brand-blue" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
          <p class="text-slate-700 leading-relaxed">{item}</p>
        </div>
      ))}
    </div>
  </div>
</section>
